# ─── MongoDB (required) ───
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bizzone

# ─── Dashboard auth ───
DASHBOARD_PASSWORD=your-secure-password
SESSION_SECRET=your-session-secret-min-32-chars

# ─── Credentials encryption ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY_V1=
CREDENTIALS_ACTIVE_KEY_VERSION=v1
CREDENTIALS_TOKEN_TTL_DAYS=14
CREDENTIALS_PUBLIC_URL=https://credentials.bizzonedigital.com
ALLOW_GENERIC_CREDENTIALS_SUBMISSION=false

# ─── Groq chatbot (credentials form) ───
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── ClickUp (optional) ───
CLICKUP_TOKEN=pk_YOUR_TOKEN_HERE
CLICKUP_LIST_ID=901326836651
CLICKUP_STATUS=not started

# ─── Google Reviews (optional) ───
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ─── Cloudinary (logo uploads) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
